# CommonGround — environment variable placeholders.
# This prototype phase uses local mock persistence. This file exists so the pattern is
# established from the start (spec §26: never commit secrets, .env.example ships placeholders
# only).

# Real moderator emails (comma-separated), set at deploy time — never commit real emails to
# src/data/communities/*.ts.
# MODERATOR_EMAILS=

# Moderator sign-in with Google (docs/MODERATION.md "Access"). From an OAuth client of type
# "Web application" in Google Cloud, with redirect URI <site>/api/auth/google/callback.
# Server-only; never give them a NEXT_PUBLIC_ name. Without both, the Google button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The Google email of the owner: the one moderator who can add and remove the others.
# OWNER_EMAIL=

# The old shared passphrase for /admin, kept only as a fallback while moderators move to Google
# sign-in (it signs in as the owner, recorded as "admin"). Remove it to retire it.
# Never commit a real value.
# ADMIN_ACCESS_CODE=

# Phase 6: Groq API key for the CommonGround Guide's actual reasoning (free tier, same provider
# already used on Synaptiq). The Guide still works without this — falls back to a message
# explaining it's unavailable — never required for the rest of the app to function.
# GROQ_API_KEY=

# Optional: the public address used in referral messages' case links. On Vercel the production
# address is detected automatically; set this only to override it (e.g. http://localhost:3000).
# PUBLIC_SITE_URL=

# Postgres for cases (a free Neon project). Use the POOLED connection string (host contains
# "-pooler"). Server-only — never give it a NEXT_PUBLIC_ name. Without it, cases are kept in
# memory and lost on restart. Setup: db/README.md.
# DATABASE_URL=
